rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Validate document ID size/pattern
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Is the user the owner of the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper functions for validating entities
    function isValidUserSetting(data) {
      return data.theme is string && (data.theme == 'light' || data.theme == 'dark')
          && data.primaryColor is string && data.primaryColor.size() <= 30
          && data.animationsEnabled is bool
          && data.layout is string && (data.layout == 'grid' || data.layout == 'list')
          && data.itemsPerPage is int && data.itemsPerPage > 0 && data.itemsPerPage <= 100;
    }

    function isValidCategory(data, userId) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.color is string && data.color.size() <= 30
          && (data.userId == userId);
    }

    function isValidLinkItem(data, userId) {
      return data.id is string && data.id.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.url is string && data.url.size() > 0 && data.url.size() <= 2000
          && data.categoryId is string && data.categoryId.size() <= 128
          && data.userId == userId
          && data.isFavorite is bool
          && data.isPinned is bool
          && data.viewsCount is int;
    }

    // Match users collection
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUserSetting(request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) && isValidUserSetting(request.resource.data);
      allow delete: if isSignedIn() && isOwner(userId);

      // Match categories subcollection
      match /categories/{categoryId} {
        allow read, list: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(categoryId) && isValidCategory(request.resource.data, userId);
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(categoryId);
      }

      // Match links subcollection
      match /links/{linkId} {
        allow read, list: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(linkId) && isValidLinkItem(request.resource.data, userId);
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(linkId);
      }
    }
  }
}
