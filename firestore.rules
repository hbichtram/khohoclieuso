rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Validate document ID size/pattern
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Is the user the owner of the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper functions for validating entities
    function isValidUserSetting(data) {
      return (!('theme' in data) || (data.theme is string && (data.theme == 'light' || data.theme == 'dark')))
          && (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() <= 30))
          && (!('animationsEnabled' in data) || data.animationsEnabled is bool)
          && (!('layout' in data) || (data.layout is string && (data.layout == 'grid' || data.layout == 'list')))
          && (!('itemsPerPage' in data) || (data.itemsPerPage is number && data.itemsPerPage > 0 && data.itemsPerPage <= 100));
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.color is string && data.color.size() <= 30;
    }

    function isValidLinkItem(data) {
      return data.id is string && data.id.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 500
          && data.url is string && data.url.size() > 0 && data.url.size() <= 8192
          && data.categoryId is string && data.categoryId.size() <= 128
          && data.isFavorite is bool
          && data.isPinned is bool
          && data.viewsCount is number;
    }

    function isValidBannerConfig(data) {
      return data.posX is number && data.posX >= 0 && data.posX <= 100
          && data.posY is number && data.posY >= 0 && data.posY <= 100
          && data.scale is number && data.scale >= 80 && data.scale <= 300
          && (!('marginTop' in data) || (data.marginTop is number && data.marginTop >= 0 && data.marginTop <= 100))
          && (!('marginBottom' in data) || (data.marginBottom is number && data.marginBottom >= 0 && data.marginBottom <= 100))
          && (!('bgUrl' in data) || data.bgUrl == null || (data.bgUrl is string && data.bgUrl.size() < 1048576))
          && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Match global app config (shared across all viewers & admins)
    match /app_config/{configId} {
      allow read, get, list: if true;
      allow create, update: if isValidBannerConfig(request.resource.data);
      allow delete: if true;
    }

    // Match global shared links collection (accessible to all viewers, managed by admin)
    match /links/{linkId} {
      allow read, get, list: if true;
      allow create, update: if isValidId(linkId) && isValidLinkItem(request.resource.data);
      allow delete: if isValidId(linkId);
    }

    // Match global shared categories collection
    match /categories/{categoryId} {
      allow read, get, list: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(request.resource.data);
      allow delete: if isValidId(categoryId);
    }

    // Match users collection
    match /users/{userId} {
      allow get, read, list: if true;
      allow create, update: if isValidUserSetting(request.resource.data);
      allow delete: if isSignedIn() && isOwner(userId);

      // Match categories subcollection
      match /categories/{categoryId} {
        allow read, get, list: if true;
        allow create, update: if isValidId(categoryId) && isValidCategory(request.resource.data);
        allow delete: if isValidId(categoryId);
      }

      // Match links subcollection
      match /links/{linkId} {
        allow read, get, list: if true;
        allow create, update: if isValidId(linkId) && isValidLinkItem(request.resource.data);
        allow delete: if isValidId(linkId);
      }
    }
  }
}
